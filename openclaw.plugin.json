{
  "id": "dgr-gate",
  "name": "DGR Gate",
  "version": "0.1.0-beta.1",
  "description": "Synthetic payment and invoice tools only. No real funds, external files or control over unrelated tools.",
  "categories": [
    "developer-tools"
  ],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "dgr_sandbox_payment",
      "dgr_invoice_attachment"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "maxPaymentMinor": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000,
        "default": 1000
      },
      "allowedDestinations": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "default": [
          "sandbox-vendor"
        ]
      },
      "maxAttachmentBytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 262144,
        "default": 4096
      }
    }
  }
}
