{
  "name": "@dgr-ai-labs/openclaw-dgr-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A deterministic gate for agent actions: nothing runs outside policy or off the record, and an action it cannot clear fails closed. Payments also require stored evidence. Two synthetic sandbox tools in this release.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DGR-AI-Labs/dgr-openclaw.git"
  },
  "files": [
    "src/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "assets/"
  ],
  "scripts": {
    "test": "node --test test/config.test.js test/actions.test.js test/gate.test.js test/plugin.test.js",
    "test:installed": "node --test test/installed.test.js",
    "test:mutations": "node scripts/mutations.mjs",
    "package:check": "node scripts/package-check.mjs",
    "check:listing": "node scripts/check-listing.mjs",
    "build-icon": "node scripts/build-icon.mjs"
  },
  "openclaw": {
    "extensions": [
      "./src/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.5 <2026.9.6",
      "minGatewayVersion": "2026.9.5"
    },
    "build": {
      "openclawVersion": "2026.9.5",
      "pluginSdkVersion": "2026.9.5"
    }
  }
}
